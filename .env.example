# Secrets — never commit real values
GROQ_API_KEY=your_groq_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Model / agent
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SIMULATOR_MODEL=openai/gpt-oss-20b
INCLUDE_REASONING=false
PROMPT_VERSION=v1
MODEL_CALL_LIMIT=15
TOOL_CALL_LIMIT=8
RECURSION_LIMIT=20
MAX_REQUESTS_PER_SESSION=30

# Context
RECENT_TURNS=4
MAX_HISTORY_TOKENS=6000

# Tools
MAX_REVIEWS=15
MAX_REVIEW_TEXT=400
COMPARE_MIN_PRODUCTS=2
COMPARE_MAX_PRODUCTS=3
COMPARE_REVIEW_EXCERPTS=3
MAX_TOOL_RESULT_CHARS=8000

# Chat / runs
CHAT_PAGE_SIZE=50
AGENT_POLL_SECONDS=2
AGENT_RUN_STALE_SECONDS=180
AGENT_WORKER_MAX_WORKERS=2
STREAM_FINAL_ANSWER=false

# Catalog
RETAILER=petbarn
DATA_MODE=auto
CATALOG_CACHE_TTL_SECONDS=300

# Ingest
SEED_PRODUCTS_PATH=data/seed_products.json
INGEST_MIN_DELAY_SECONDS=1.0
INGEST_HTTP_TIMEOUT_SECONDS=20.0
INGEST_MAX_RETRIES=3
INGEST_MAX_PRODUCTS=500
INGEST_TARGET_REVIEWS=10
MAX_REVIEW_PAGES=8
SNAPSHOT_EXCERPT_COUNT=10

# Sitemap
SITEMAP_REQUIRED=false
MAX_SITEMAP_CHILDREN=8
MAX_SITEMAP_BYTES=25000000
SITEMAP_CACHE_DIR=data/raw/sitemap

# Logging
LOG_LEVEL=INFO
