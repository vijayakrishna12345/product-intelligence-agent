      },
      {
        "id": "tool-boundary",
        "label": "Tool boundary",
        "focus": ["agent", "middleware", "tools", "services"],
        "note": "Four catalog tools only; middleware blocks loops, leaks, and URLs."
      },
      {
        "id": "catalog-fallback",
        "label": "Catalog fallback",
        "focus": ["services", "catalog_repo", "postgres", "json_files"],
        "note": "Per-SKU lookup is Postgres, then catalog.json, then sample_catalog.json."
      }
    ]
