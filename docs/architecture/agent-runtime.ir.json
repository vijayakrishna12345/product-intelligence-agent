  "cards": [
    {
      "dot": "emerald",
      "title": "Request path",
      "items": [
        "Chat submit runs LangChain off the Streamlit script thread",
        "Groq gpt-oss-120b with include_reasoning=false"
      ]
    },
    {
      "dot": "rose",
      "title": "Hard tool boundary",
      "items": [
        "Four tools: search, details, reviews, compare",
        "No HTTP, Playwright, SQL, shell, or secrets tools"
      ]
    },
    {
      "dot": "orange",
      "title": "Persistence",
