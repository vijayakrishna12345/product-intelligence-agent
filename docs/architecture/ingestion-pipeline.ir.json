  "cards": [
    {
      "dot": "emerald",
      "title": "Primary ingest path",
      "items": [
        "Seeds first, then sitemap fill, then UrlFetcher with delay and retries",
        "Accepted rows upsert Postgres and merge compact catalog.json"
      ]
    },
    {
      "dot": "rose",
      "title": "Crawl controls",
      "items": [
        "HTTPS allowlist, DENY_PATTERNS, robots.txt; no BV passkeys or bvstate URLs",
        "Skip Playwright when stored reviews already meet the target count"
      ]
    },
    {
      "dot": "orange",
      "title": "Isolation",
      "items": [
        "Tables: crawl_runs, products, product_reviews, crawl_pages",
        "No Groq, Streamlit, or LangChain on this path"
      ]
    }
  ]
