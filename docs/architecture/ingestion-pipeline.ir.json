{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "PIA Offline Ingestion Pipeline",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [1080, 640],
    "views": [
      {
        "id": "discovery-path",
        "label": "URL discovery",
        "focus": ["seeds", "petbarn", "sitemap", "policy"],
        "note": "Seeds are processed first, then sitemap fill, then HTTPS policy."
      },
      {
        "id": "extract-path",
        "label": "Extract and gate",
        "focus": ["http", "parser", "reviews", "quality"],
        "note": "JSON-LD products and Playwright reviews meet at the quality gate."
      },
      {
        "id": "persist-path",
        "label": "Dual persist",
        "focus": ["quality", "crawl", "postgres", "snapshot"],
        "note": "CrawlRepository upserts Postgres and merges a compact catalog.json."
      }
    ]
  },
  "stages": [
    { "label": "Sources" },
    { "label": "Sitemap" },
    { "label": "Fetch" },
    { "label": "Extract" },
    { "label": "Persist" }
  ],
